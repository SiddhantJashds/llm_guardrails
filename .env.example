# Copy to .env and fill in. Both services read these via os.getenv(...).

# Shared DB connection (shared/db.py). Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./governance.db
# Postgres example, once you're past laptop-only demo:
# DATABASE_URL=postgresql+psycopg2://governance:governance@localhost:5432/governance

# proxy/main.py
UPSTREAM_LLM_BASE_URL=https://api.openai.com/v1
UPSTREAM_LLM_API_KEY=sk-replace-me
GOVERNANCE_API_URL=http://localhost:8001

# governance_api/receipts/writer.py -- server-side only, never expose this
RECEIPT_SIGNING_SECRET=change-me-before-the-demo

# dashboard/ (set window.GOVERNANCE_API_BASE_URL in index.html/user.html instead
# if you're serving the dashboard as static files without templating)
GOVERNANCE_API_BASE_URL=http://localhost:8001

# run.sh Bench mode for GuardRailBench-Sample runs (0 = normal dev).
# WITH_BRIDGE=1: serve the bench hook contract on :8080 (dashboard moves to
# :8081) and skip the proxy -- bench apps call the LLM directly and the bench
# server itself needs :8000. Flip back to 0 afterwards.
WITH_BRIDGE=0

# Detector backend: ner (regex+spaCy, default) | laya (decision model only) |
# cascade (both, union of violations, worst verdict wins). laya/cascade call
# LAYA_ENDPOINT (/v1/systemone) once per check; unset LAYA_* means ner.
DECISION_MODE=ner
LAYA_ENDPOINT=
LAYA_API_KEY=
LAYA_MODEL=laya-multilingual
LAYA_TIMEOUT_S=10
LAYA_THRESHOLD=0.5
# 1: Laya error -> fall back to ner (demo-safe, tunnels die); 0: fail closed.
LAYA_FAIL_OPEN=1
